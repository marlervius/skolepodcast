# Kopier til .env.local og fyll inn. .env.local skal aldri inn i git.
# Finnes i Supabase → Project Settings → API (eller «Connect»).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Minst 32 tilfeldige tegn. Signerer lærerens innloggingscookie.
LYTTEROM_SECRET=
# Koden nye lærere må oppgi. I produksjon er registreringen stengt uten denne.
LYTTEROM_INVITE_CODE=
