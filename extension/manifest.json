{
  "manifest_version": 3,
  "name": "Lytterom for NotebookLM",
  "version": "1.0.0",
  "description": "Send podkaster, videoer og nøkkelpunkter fra NotebookLM rett til fagrommene dine i Lytterom.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lytterom for NotebookLM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://skolepodcast.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://notebooklm.google.com/*"],
      "css": ["content.css"],
      "js": ["audio-compress.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
